def runInDocker(String image, Closure body) {
  docker.image(image).inside {
        body()
  }
}

pipeline {
  // `agent any` = el pipeline se ejecuta en cualquier nodo/agente disponible.
  agent any

    environment {
    CI_IMAGE_NAME = "java-ci-tools:${env.BUILD_NUMBER}"
    APP_URL = 'http://localhost:5001/'
    }
  // =========================
  // Ejercicio 6.3 (parámetros)
  // =========================
  parameters {
    booleanParam(name: 'RUN_CD', defaultValue: false, description: 'Ejecutar CD (solo develop/master)')
  }
  stages {
    stage('Info') {
      steps {
        // TODO (E1): imprime JOB_NAME y BUILD_NUMBER
        sh 'echo "JOB_NAME: ${JOB_NAME}"'
        sh 'echo "BUILD_NUMBER: ${BUILD_NUMBER}"'
      }
    }

    // =========================
    // Ejercicio 3 (preparación): construir imagen CI con make
    // =========================
    stage('CI - Build tools image') {
      steps {
        script {
          // TODO (E3): Construye una imagen de CI desde devops/ci.Dockerfile.
          // Ejemplo:
          echo "Building CI image: ${env.CI_IMAGE_NAME}"
          docker.build(env.CI_IMAGE_NAME, '-f devops/ci.Dockerfile .')
        }
      }
    }

    // =========================
    // Ejercicio 3 (lint/test con Makefile) + Ejercicio 4 (refactor con runInDocker)
    // =========================
    stage('CI - Lint') {
      steps {
        script {
          // TODO (E3/E4): Ejecuta `make lint` dentro de la imagen CI construida.
          runInDocker(env.CI_IMAGE_NAME) { sh 'make lint' }
        }
      }
    }

    stage('CI - Test') {
      steps {
        script {
          // TODO (E3/E4): Ejecuta `make test` dentro de la imagen CI construida.
          runInDocker(env.CI_IMAGE_NAME) { sh 'make test' }
        }
      }
    }
    stage('CI - Build image') {
      steps {
        script {
          // TODO (E5): Construye la imagen Docker usando el Dockerfile del repo:
          def version = readFile('VERSION').trim()
          docker.build(env.CI_IMAGE_NAME, "--build-arg VERSION=${version} -f devops/Dockerfile .")
        }
      }
    }
    // =========================
    // Ejercicio 6 (compose) + Ejercicio 6.1 (solo develop/master) + Ejercicio 6.3 (RUN_CD)
    // =========================
    stage('CD') {
      when {
        // [E6.1][E6.3] TODO: ejecutar CD por rama o parámetro.
        // - Si RUN_CD=true, ejecutar en cualquier rama.
        // - Si RUN_CD=false, ejecutar solo en develop/master.
        // Ejemplo:
        anyOf {
          expression { return params.RUN_CD }
          branch 'develop'
          branch 'master'
        }
      }
      steps {
        script {
          env.DEPLOY_ENV = (env.BRANCH_NAME == 'master') ? 'pro' : 'dev'
          echo "Deploying to ${env.DEPLOY_ENV}"

          echo "CD habilitado: RUN_CD=${params.RUN_CD}, branch=${env.BRANCH_NAME}"

          echo 'Ejecutando aplicación con docker-compose'
          sh "docker compose -p ${env.DEPLOY_ENV} up -d"
          echo 'Esperando a que la aplicación se inicie...'
          sh 'sleep 5'
          echo 'Mostrando logs de la aplicación:'
          sh "docker compose -p ${env.DEPLOY_ENV} logs app"
        }
      }
      post {
        // [E6.5] TODO: añade limpieza y reporting.
        always {
          sh 'docker compose down --volumes || true'
          sh "docker rmi ${env.CI_IMAGE_NAME} || true"
        }
        success { echo 'SUCCESS' }
        failure {
          echo 'FAILURE'
          sh 'docker compose logs || true'
        }
      }
    }
  }
}
